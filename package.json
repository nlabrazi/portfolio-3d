    "@fortawesome/vue-fontawesome": "^3.3.3",
    "@nuxtjs/i18n": "^10.6.0",
    "@nuxtjs/tailwindcss": "^6.14.0",
    "nuxt": "^4.7.0",
    "three": "^0.187.0",
    "vue": "^3.5.46"
  },
  "devDependencies": {
    "@nlabrazi/config-biome": "^0.2.0",
    "@nlabrazi/config-playwright": "^0.1.0",
    "@nlabrazi/config-vitest": "^0.2.4",
    "@nlabrazi/tsconfig": "^0.1.0",
    "@types/three": "^0.187.0"
